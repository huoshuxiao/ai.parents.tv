<?xml version="1.0" encoding="utf-8"?>
<!-- 系统在 Compose 画出第一帧之前显示的就是这张窗口背景。以前它是纯色 #070B14，
     在电视上看起来就是一块黑屏（用户 10-25「程序刚启动时有黑屏」）。
     改成同色系渐变 + 居中的 App 图标：等待那一两秒看到的是品牌画面，不是黑屏。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#0C1424"
                android:startColor="#070B14" />
        </shape>
    </item>
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
