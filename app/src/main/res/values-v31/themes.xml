<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 的启动画面由系统接管：只设 windowBackground 时，系统启动画面仍用默认的黑色底，
         冷启动那几秒就是用户说的「黑屏」。这里把系统启动画面的底色与图标也钉成本应用的样子。 -->
    <style name="Theme.ParentsTV" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/tv_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:colorAccent">@color/tv_accent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
